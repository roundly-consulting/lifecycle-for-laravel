{
    "name": "roundly-consulting/lifecycle-for-laravel",
    "description": "Status lifecycles for Eloquent models: guarded named transitions, limits and quotas, expiry and scheduled transitions, rollbacks and an append-only history.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "state-machine",
        "lifecycle",
        "workflow",
        "status",
        "transitions",
        "expiry",
        "audit-trail"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/lifecycle-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/lifecycle-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Lifecycle\\": "src",
            "RoundlyConsulting\\Lifecycle\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Lifecycle\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Lifecycle\\LifecycleServiceProvider"
            ],
            "aliases": {
                "Lifecycles": "RoundlyConsulting\\Lifecycle\\Facades\\Lifecycles"
            }
        }
    }
}
